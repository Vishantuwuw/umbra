    end

    if ownedItems[itemName] then
        isOwned = true
        if priceLbl and priceLbl:IsA("TextLabel") then
            priceLbl.Text = i18n[currentLang].owned
        end
    end

    ghost.MouseButton1Click:Connect(function()
        local giftedTo = nil
        pcall(function()
            local giftBtn = game:GetService("Players").LocalPlayer.PlayerGui.Shop.Shop.GiftPlayerSelect.Buttons.GiftButton
